# Server
PORT=3100
TRACKER_DOMAIN=https://track.yourdomain.com

# Slack notifications
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0123456789

# Email notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASS=your-app-password
ALERT_EMAIL_TO=sales@yourdomain.com
ALERT_EMAIL_FROM=alerts@yourdomain.com

# Enrichment / de-anonymization
CLEARBIT_API_KEY=sk_your_clearbit_key

# Intent thresholds
HIGH_INTENT_SCORE_THRESHOLD=50
NOTIFY_COOLDOWN_MINUTES=60

# SOFI preapproval: shared secret SOFI sends as x-api-key (route is disabled while empty)
PREAPPROVAL_API_KEY=
